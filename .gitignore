.mypy_cache/

# Build (already in dist/)
dist/

# 2026-09-08: admin-specific eval test data (queries reference D:/AI/ paths).
# Public release should ship a universal eval_set.jsonl without operator paths.
# Admin keeps a local copy at tests/eval_set.jsonl (gitignored).
tests/eval_set.jsonl

# 2026-09-08: astor runtime metrics (generated by eval_runner / sweep / reembed)
# Kept locally for trend tracking, NOT shipped to source dist
astor/metrics/eval_*.json
astor/metrics/reembed_*.json
astor/metrics/eval_history.jsonl
astor/metrics/eval_sweep_history.jsonl

# PII rewrite scaffolding (transient, used by git filter-branch only)
.pii-replace.py
.pii-replacements.sed
