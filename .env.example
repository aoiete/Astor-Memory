# Astor-Memory env var template — copy to .env and fill in.
# All vars below have sensible defaults if not set (see source code).
#
# Operator paths
ASTOR_DIR=~/.astor

# Server bind (default 127.0.0.1:7803, used by hermes_adapter.py)
ASTOR_BASE_URL=http://127.0.0.1:7803

# LLM extract (forge/llm_extract.py)
# Either OPENAI_API_KEY or OPENROUTER_API_KEY or MINIMAX_API_KEY
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openrouter.ai/api/v1
OPENROUTER_API_KEY=
MINIMAX_API_KEY=

# Rerank (nest/llm_rerank.py)
ASTOR_RERANK=1
ASTOR_RERANK_MODEL=google/gemini-3-flash-preview
ASTOR_RERANK_K=30
ASTOR_RERANK_TOP=5

# Recursive expansion / multihop / graph (server.py)
ASTOR_EXPANSION=1
ASTOR_MULTIHOP=1
ASTOR_GRAPH=1

# Benchmark datasets (nest/conversation_graph.py)
LOCOMO_DATASET=~/.astor/benchmarks/locomo10.json

# Internal logging
ASTOR_NUDGE_EVERY_N_TURNS=5