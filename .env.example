# astor-memory server .env template
#
# Copy this file to .env and fill in your own values.
# .env is in .gitignore (both source repo and runtime) — your keys
# never leak into git history.
#
# Restart the server after editing: `python restart.py restart`

# Required: LLM provider API key (used by astor forge extractor)
# Pick ONE of the following (each maps to a `_call_*` in
# astor_memory/forge/llm_extract.py):
#
#   OPENAI_API_KEY     — OpenAI Chat Completions
#   MINIMAX_API_KEY    — MiniMax-M3 (default if set)
#   OPENROUTER_API_KEY — OpenRouter (multi-provider proxy)
#   ANTHROPIC_API_KEY  — Anthropic Messages API
#   KIMI_API_KEY       — Moonshot Kimi
#
# Without a key here, mode='llm' silently falls back to regex. The server
# will still work (regex extraction is good enough for the 3-zone architecture)
# but you'll miss LLM-level understanding (keywords/context/event_date).

OPENAI_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=

# Optional: enable LLM-driven decay sweep (30d no-recall halve,
# 90d no-recall tombstone). Off by default — turn on after observing
# access_count distributions look reasonable.
# ASTOR_DECAY_SWEEP=0

# Optional: disable access tracking entirely (no access_count bump
# on /v1/read). Default: enabled.
# ASTOR_ACCESS_TRACKING=1

# Optional: enable LLM rerank on /v1/read. Default: enabled.
# ASTOR_RERANK=1
